# ─────────────────────────────────────────────────────────────────────────────
#  SEGREDOS E CREDENCIAIS — nada daqui pode entrar no Git.
#  O que entra no histórico do Git não sai fácil: mesmo apagado depois, o valor
#  continua recuperável em qualquer clone. Na dúvida, ignore.
# ─────────────────────────────────────────────────────────────────────────────

# Variáveis de ambiente: bloqueia tudo, libera só o exemplo (sem valor real).
.env
.env.*
!.env.example

# Chaves, certificados e tokens
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.cer
*.crt
id_rsa*
id_ed25519*
*.token
token.txt
tokens.txt
senha*.txt
senhas*.txt
password*.txt
*credentials*.json
*service-account*.json
secrets.*
.secrets/

# Credenciais de ferramentas
.vercel
.turso
.netlify
.aws/
.npmrc
.yarnrc

# ─────────────────────────────────────────────────────────────────────────────
#  DADOS DE CLIENTE — o banco local tem dados pessoais reais sob a LGPD.
# ─────────────────────────────────────────────────────────────────────────────
local.db
local.db-shm
local.db-wal
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql.gz
/backups/
/exports/

# ─────────────────────────────────────────────────────────────────────────────
#  Build, dependências e temporários
# ─────────────────────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*

/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

.DS_Store
.idea
.vscode/*
!.vscode/extensions.json

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
