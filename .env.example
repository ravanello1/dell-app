# ─────────────────────────────────────────────────────────────
#  Dell App — variáveis de ambiente
#  Copie para .env.local e preencha. NUNCA versione .env.local.
# ─────────────────────────────────────────────────────────────

# Banco de dados (libSQL / Turso)
# Desenvolvimento local: um arquivo SQLite comum
DATABASE_URL="file:./local.db"
# Produção (Turso): DATABASE_URL="libsql://dell-app-SEU-USUARIO.turso.io"
# e o token gerado por `turso db tokens create dell-app`
DATABASE_AUTH_TOKEN=""

# Segredo que assina o cookie de sessão.
# Gere um novo com: openssl rand -base64 48
AUTH_SECRET=""

# Usuário dono criado pelo `npm run db:seed` (só é lido no seed)
SEED_OWNER_NAME="Dell"
SEED_OWNER_EMAIL="contato@dellbeautystudio.com.br"
SEED_OWNER_PASSWORD=""

# Identidade do studio exibida no app
NEXT_PUBLIC_STUDIO_NAME="Dell Beauty Studio"
NEXT_PUBLIC_STUDIO_CITY="Curitiba"
NEXT_PUBLIC_STUDIO_STATE="PR"

# Notificações push (Web Push). Gere um par com:
#   npx tsx --eval "import w from 'web-push'; console.log(w.generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@dellbeautystudio.com.br"
